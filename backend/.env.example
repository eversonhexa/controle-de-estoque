# Copie este arquivo para ".env" e ajuste os valores.

# Ambiente: development | production | test
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# Banco de dados MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=estoque_app
DB_PASSWORD=troque-esta-senha
DB_NAME=controle_estoque

# Banco usado pelos testes automatizados (será APAGADO e recriado em cada execução)
DB_NAME_TEST=controle_estoque_teste

# Sessão: use um valor longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
# Expiração da sessão por inatividade, em minutos
SESSION_MINUTES=30

# Em produção atrás de proxy reverso com HTTPS (nginx, IIS), defina 1
TRUST_PROXY=0

# Limite de tentativas de login por IP a cada 15 minutos
LOGIN_MAX_TENTATIVAS=10

# Custo do bcrypt
BCRYPT_ROUNDS=12

# Caminho do utilitário mysqldump para "npm run backup" (opcional)
MYSQLDUMP_PATH=mysqldump
BACKUP_DIR=../backups
